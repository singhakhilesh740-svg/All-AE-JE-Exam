rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isLoggedIn()
        && request.auth.token.email == '112ce0489@gmail.com';
    }

    // ── Questions ──────────────────────────────────────────────────────────
    // Any logged-in user can read; only admin can write.
    match /exams/{examId}/questions/{questionId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }
    match /exams/{examId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Notes ──────────────────────────────────────────────────────────────
    match /notes/{subjectId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // READ: any logged-in user can read user docs (needed for Google-login merge).
    // WRITE: only the owner can write their own doc (includes fcmToken field).
    match /users/{userId} {
      allow read:  if isLoggedIn();
      allow write: if isOwner(userId);

      // Subcollections (attempts, bookmarks, sessions) — owner can read/write, admin can read.
      match /{subCollection}/{docId} {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
    }

    // ── Custom Exams Config ────────────────────────────────────────────────
    match /exams_config/{examId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Reports ────────────────────────────────────────────────────────────
    // Any logged-in user can create; only admin can read/update/delete.
    match /reports/{reportId} {
      allow create: if isLoggedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Feedback ──────────────────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow create: if isLoggedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Notifications (broadcast) ──────────────────────────────────────────
    // Admin creates; all logged-in users can read (for in-app notification history).
    // Cloud Function adds sent:true / sentAt after broadcasting via FCM.
    match /notifications/{notifId} {
      allow create, update, delete: if isAdmin();
      allow read:                   if isLoggedIn();
    }

    // ── NT Config (Non-Tech subsections) ──────────────────────────────────────
    match /nt_config/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── NT Exams (separate from main exams_config) ─────────────────────────────
    match /nt_exams/{examId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── NT Questions (separate from main exams/{}/questions) ─────────────────
    match /nt_questions/{questionId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── NT Notes (separate from main notes) ──────────────────────────────────
    match /nt_notes/{subsectionId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Deny everything else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
